{
  "$schema": "./manifest.schema.json",
  "schema_version": "1.0.0",
  "tools": [
    {
      "id": "python",
      "name": "Python interpreter",
      "ownership": "developer-managed",
      "requirement": "required",
      "lanes": ["core"],
      "executable": "python3",
      "version_probe": "python3 --version",
      "validated_version": "3.11",
      "accepted_range": ">=3.11",
      "pinned": false,
      "install": { "by": "developer", "source": "system", "command": null },
      "network_host": null,
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": true,
      "reconcile": "probe-only",
      "notes": "The single hard prerequisite. The wrapper is Python; nothing runs without it."
    },
    {
      "id": "git",
      "name": "Git",
      "ownership": "developer-managed",
      "requirement": "optional",
      "lanes": ["history"],
      "executable": "git",
      "version_probe": "git --version",
      "validated_version": null,
      "accepted_range": ">=2.30",
      "pinned": false,
      "install": { "by": "developer", "source": "system", "command": null },
      "network_host": null,
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "probe-only",
      "notes": "Enables history, ownership/co-change evidence, and reproducible citations. Non-git folders are supported with disclosed reduced coverage."
    },
    {
      "id": "analysis-wrapper",
      "name": "Analysis wrapper (Python package, core)",
      "ownership": "analyzer-managed",
      "requirement": "required",
      "lanes": ["core"],
      "executable": "project-analysis-wrapper",
      "version_probe": "project-analysis-wrapper --version",
      "validated_version": "0.4.0",
      "accepted_range": null,
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pip", "command": "python3 -m analysis_wrapper.bootstrap" },
      "network_host": "pypi.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": true,
      "reconcile": "rebuild",
      "notes": "Core runtime dependencies are stdlib-only; the install step may still need pip/setuptools/build-backend."
    },
    {
      "id": "pydriller",
      "name": "PyDriller (history extra)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["history"],
      "executable": null,
      "version_probe": null,
      "validated_version": "2.10",
      "accepted_range": "==2.10",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pip", "command": "python3 -m analysis_wrapper.bootstrap" },
      "network_host": "pypi.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "reinstall",
      "notes": "Primary history analysis; absence falls back to disclosed plain-Git and reports partial."
    },
    {
      "id": "sqlglot",
      "name": "SQLGlot (sql extra)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["sql"],
      "executable": null,
      "version_probe": null,
      "validated_version": "30.12.0",
      "accepted_range": "==30.12.0",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pip", "command": "python3 -m analysis_wrapper.bootstrap" },
      "network_host": "pypi.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "reinstall",
      "notes": "Parses raw SQL DDL for the table lane; SQL coverage is disclosed and never reported complete on failure."
    },
    {
      "id": "markdown-it-py",
      "name": "markdown-it-py (report extra)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["report"],
      "executable": null,
      "version_probe": null,
      "validated_version": "3.0.0",
      "accepted_range": "==3.0.0",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pip", "command": "python3 -m analysis_wrapper.bootstrap" },
      "network_host": "pypi.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "reinstall",
      "notes": "Renders the offline HTML export. Markdown reports are produced regardless."
    },
    {
      "id": "node",
      "name": "Node.js runtime",
      "ownership": "developer-managed",
      "requirement": "optional",
      "lanes": ["js"],
      "executable": "node",
      "version_probe": "node --version",
      "validated_version": null,
      "accepted_range": "22.x || 24.x || >=26",
      "pinned": false,
      "install": { "by": "developer", "source": "system", "command": null },
      "network_host": null,
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "probe-only",
      "notes": "Supplied by the developer via nvm/asdf/mise/system. Required for the JS/TS lane; absent => reduced coverage."
    },
    {
      "id": "pnpm",
      "name": "pnpm",
      "ownership": "developer-managed",
      "requirement": "optional",
      "lanes": ["js"],
      "executable": "pnpm",
      "version_probe": "pnpm --version",
      "validated_version": null,
      "accepted_range": ">=9",
      "pinned": false,
      "install": { "by": "developer", "source": "system", "command": null },
      "network_host": null,
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "probe-only",
      "notes": "Used by setup to install the analyzer-owned node_tools packages (frozen lockfile, ignore-scripts)."
    },
    {
      "id": "dependency-cruiser",
      "name": "dependency-cruiser (node_tools)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["js"],
      "executable": null,
      "version_probe": null,
      "validated_version": "18.1.0",
      "accepted_range": "==18.1.0",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pnpm", "command": "pnpm install --dir wrapper/node_tools --frozen-lockfile --ignore-scripts" },
      "network_host": "registry.npmjs.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": true,
      "reconcile": "rebuild",
      "notes": "JS/TS dependency graph + cycles. Uses only the analyzer-owned env binary, never a global/target-resolved one."
    },
    {
      "id": "typescript",
      "name": "TypeScript compiler (node_tools)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["js"],
      "executable": null,
      "version_probe": null,
      "validated_version": "5.9.3",
      "accepted_range": "==5.9.3",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "pnpm", "command": "pnpm install --dir wrapper/node_tools --frozen-lockfile --ignore-scripts" },
      "network_host": "registry.npmjs.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": true,
      "reconcile": "rebuild",
      "notes": "Official compiler API for tsconfig resolution and the JS/TS call graph."
    },
    {
      "id": "go",
      "name": "Go toolchain",
      "ownership": "developer-managed",
      "requirement": "optional",
      "lanes": ["go"],
      "executable": "go",
      "version_probe": "go version",
      "validated_version": null,
      "accepted_range": ">=1.25",
      "pinned": false,
      "install": { "by": "developer", "source": "system", "command": null },
      "network_host": null,
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": false,
      "reconcile": "probe-only",
      "notes": "Required for the Go lane and to build the callgraph binary. Not needed for non-Go targets."
    },
    {
      "id": "go-callgraph",
      "name": "Go callgraph (VTA)",
      "ownership": "analyzer-managed",
      "requirement": "optional",
      "lanes": ["go"],
      "executable": "callgraph",
      "version_probe": null,
      "validated_version": "v0.48.0",
      "accepted_range": "==v0.48.0",
      "pinned": true,
      "install": { "by": "analyzer-setup", "source": "go-proxy", "command": "GOBIN=<data-root>/go_tools/bin go install golang.org/x/tools/cmd/callgraph@v0.48.0" },
      "network_host": "proxy.golang.org",
      "platforms": ["macos", "linux", "wsl2"],
      "runtime_contract": true,
      "reconcile": "rebuild",
      "notes": "Installed into an analyzer-owned GOBIN. The offline Go lane pins GOPROXY=off at analysis time."
    },
    {
      "id": "scc",
